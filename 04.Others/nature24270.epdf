<head>
    <title>Mastering the game of Go without human knowledge | Nature</title>
    <link rel="canonical" href="/articles/nature24270">
    <noscript>
        <meta http-equiv="Refresh" content="0; https://www.nature.com/articles/nature24270.pdf">
    </noscript>
    
    
    <meta name="journal_id" content="41586"/>
    <meta name="dc.title" content="Mastering the game of Go without human knowledge"/>
    <meta name="dc.source" content="Nature 2017 550:7676"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="Nature Publishing Group"/>
    <meta name="dc.date" content="2017-10-19"/>
    <meta name="dc.type" content="OriginalPaper"/>
    <meta name="dc.language" content="En"/>
    <meta name="dc.copyright" content="2017 Macmillan Publishers Limited, part of Springer Nature. All rights reserved."/>
